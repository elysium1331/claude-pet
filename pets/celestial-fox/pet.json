{
  "name": "Celestial Fox",
  "file": "celestial-fox.riv",
  "artboard": "CelestialFox",
  "stateMachine": "PetStateMachine",
  "artFacing": 1,
  "binding": {
    "stateProperty": "state",
    "usageProperties": {
      "session": "session",
      "weekly": "weekly",
      "model": "fable"
    },
    "usageColorProperties": {
      "session": "sessionColor",
      "weekly": "weeklyColor",
      "model": "fableColor"
    },
    "lightBackdropProperty": "lightBackdrop",
    "statsOpenProperty": "statsOpen",
    "statsSideProperty": "statsSide",
    "hoveredProperty": "hovered",
    "lookXProperty": "lookX",
    "lookYProperty": "lookY"
  },
  "states": {
    "idle": 0,
    "sleeping": 1,
    "working": 2,
    "needsAttention": 3,
    "done": 4,
    "idea": 5,
    "lowUsage": 6,
    "limitReached": 7,
    "lounging": 8,
    "workingBusy": 9,
    "confused": 10,
    "disconnected": 11
  },
  "reactions": {
    "wake": "perkUp",
    "appear": "appear",
    "disappear": "disappear",
    "greet": "greet",
    "goodbye": "goodbye",
    "usageReset": "usageReset",
    "limitHit": "limitHit",
    "alert": "alertRing",
    "approve": "approve",
    "taskDone": "taskDone",
    "error": "error"
  },
  "timings": {
    "disappearMs": 850,
    "goodbyeMs": 1700,
    "statsMergeMs": 400
  },
  "fidgets": [
    { "trigger": "lookAround", "ms": 3000, "states": ["idle", "lounging"] },
    { "trigger": "stretch", "ms": 3000 },
    { "trigger": "yawn", "ms": 2500, "states": ["idle", "lounging"] },
    { "trigger": "orbPlay", "ms": 3500 },
    { "trigger": "tailChase", "ms": 3000 },
    { "trigger": "scratchEar", "ms": 2000, "states": ["idle", "lounging"] },
    { "trigger": "sneeze", "ms": 1500 }
  ],
  "bodyInsets": { "top": 0.045, "right": 0.123, "bottom": 0.078, "left": 0.123 },
  "stateInsets": {
    "lounging": { "top": 0.662, "right": 0.195, "bottom": 0.017, "left": 0.018 }
  },
  "size": { "width": 560, "height": 600 }
}
