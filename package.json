{
  "name": "claude-pet",
  "productName": "Claude Pet",
  "version": "1.0.1",
  "description": "Meet Lumi: an animated desktop pet for Windows that shows your Claude plan usage at a glance and reacts to Claude Code. Unofficial; not affiliated with Anthropic.",
  "main": "src/main/main.js",
  "private": true,
  "author": "elysium1331",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "icon": "electron build/make-icon.js",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "io.github.elysium1331.claudepet",
    "productName": "Claude Pet",
    "copyright": "Copyright © 2026 elysium1331",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "pets/**/*",
      "!pets/**/*-source.zip",
      "!pets/**/state-map.md",
      "package.json",
      "LICENSE"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Claude Pet",
      "runAfterFinish": true,
      "include": "build/installer.nsh"
    }
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@rive-app/webgl2": "2.42.1"
  }
}
